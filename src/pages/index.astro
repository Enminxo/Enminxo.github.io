---
import { getCollection } from 'astro:content';
import CallToAction from '../components/CallToAction.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Grid from '../components/Grid.astro';
import Icon from '../components/Icon.astro';
import PortfolioPreview from '../components/PortfolioPreview.astro';
import ProfileHero from '../components/ProfileHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/translations';

const lang = 'en';
const t = useTranslations(lang);

const projects = (await getCollection('work'))
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 3);

const publications = (await getCollection('publications'))
	.filter((p) => p.data.featured)
	.sort((a, b) => b.data.year - a.data.year)
	.slice(0, 3);

// Currently Building: latest log entry + its parent project
const allLogs = await getCollection('logs');
const latestLog = allLogs.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
const allWork = await getCollection('work');
const activeProject = latestLog
	? allWork.find((w) => w.id === latestLog.data.project)
	: null;
---

<BaseLayout lang={lang}>
	<div class="stack gap-20 lg:gap-40">
		<div class="wrapper">
			<ProfileHero lang={lang} />
		</div>

		<main class="wrapper stack gap-20 lg:gap-32">

			<!-- Currently Building -->
			{activeProject && latestLog && (
				<section class="now-building">
					<div class="now-label">
						<span class="live-dot" aria-hidden="true"></span>
						<span>{t('building.label')}</span>
					</div>
					<div class="now-card">
						<div class="now-project-info">
							<h3 class="now-project-title">{activeProject.data.title}</h3>
							<p class="now-project-desc">{activeProject.data.description}</p>
						</div>
						<div class="now-latest-update">
							<span class="now-update-label">{t('building.latest')}</span>
							<time class="now-update-date" datetime={latestLog.data.date.toISOString()}>
								{latestLog.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
							</time>
							<p class="now-update-title">{latestLog.data.title}</p>
							<a class="now-follow-link" href={`/projects/${activeProject.id}/`}>
								{t('building.follow')} <Icon icon="arrow-right" size="0.9em" />
							</a>
						</div>
					</div>
				</section>
			)}

			<!-- Featured Publications -->
			{publications.length > 0 && (
				<section class="section">
					<header class="section-header stack gap-2 lg:gap-4">
						<h3>{t('research.publications')}</h3>
					</header>
					<ul class="pub-list">
						{publications.map((pub) => (
							<li class="pub-card">
								<div class="pub-venue">{pub.data.venue} · {pub.data.year}</div>
								<h4 class="pub-title">{pub.data.title}</h4>
								<p class="pub-authors">{pub.data.authors}</p>
								{pub.data.abstract && <p class="pub-abstract">{pub.data.abstract}</p>}
								<div class="pub-links">
									{pub.data.pdf && (
										<a href={pub.data.pdf} class="pub-link" target="_blank" rel="noopener noreferrer">
											<Icon icon="arrow-right" size="0.9em" /> PDF
										</a>
									)}
									{pub.data.code && (
										<a href={pub.data.code} class="pub-link" target="_blank" rel="noopener noreferrer">
											<Icon icon="github-logo" size="0.9em" /> Code
										</a>
									)}
								</div>
							</li>
						))}
					</ul>
					<div class="cta-row">
						<CallToAction href="/research/">
							{lang === 'es' ? 'Ver investigación' : 'All Research'}
							<Icon icon="arrow-right" size="1.2em" />
						</CallToAction>
					</div>
				</section>
			)}

			<!-- Featured Projects -->
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h3>{t('projects.featured')}</h3>
					<p>{t('projects.subtitle')}</p>
				</header>
				<div class="gallery">
					<Grid variant="offset">
						{projects.map((project) => (
							<li>
								<PortfolioPreview project={project} />
							</li>
						))}
					</Grid>
				</div>
				<div class="cta">
					<CallToAction href="/projects/">
						View All
						<Icon icon="arrow-right" size="1.2em" />
					</CallToAction>
				</div>
			</section>
		</main>

		<ContactCTA lang={lang} />
	</div>
</BaseLayout>

<style>
	/* Currently Building */
	.now-building {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.now-label {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: var(--text-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent-regular);
	}

	.live-dot {
		display: inline-block;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--accent-regular);
		animation: pulse 2s ease-in-out infinite;
		flex-shrink: 0;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.4; transform: scale(0.85); }
	}

	.now-card {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 1.5rem;
		border: 1px solid var(--accent-dark);
		border-radius: 1rem;
		background: var(--gray-999_40);
	}

	.now-project-title {
		font-size: var(--text-2xl);
		color: var(--gray-0);
		font-weight: 700;
		margin-bottom: 0.4rem;
	}

	.now-project-desc {
		font-size: var(--text-md);
		color: var(--gray-300);
		line-height: 1.5;
		max-width: 60ch;
	}

	.now-latest-update {
		padding-top: 1.25rem;
		border-top: 1px solid var(--gray-800);
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.now-update-label {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--gray-400);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.now-update-date {
		font-size: var(--text-sm);
		color: var(--accent-regular);
		font-weight: 500;
	}

	.now-update-title {
		font-size: var(--text-md);
		color: var(--gray-100);
		font-weight: 500;
		margin-top: 0.1rem;
	}

	.now-follow-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 0.75rem;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--accent-regular);
		text-decoration: none;
	}

	.now-follow-link:hover {
		text-decoration: underline;
	}

	/* Sections */
	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);
		content: '';
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background:
			url('/assets/backgrounds/noise.png') top center/220px repeat,
			var(--hero-bg) center center / var(--bg-gradient-size) no-repeat,
			var(--gray-999);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 50ch;
		font-size: var(--text-md);
		color: var(--gray-300);
	}

	.section-header h3 { font-size: var(--text-2xl); }

	/* Publications */
	.pub-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.pub-card {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		background: var(--gray-999_40);
	}

	.pub-venue {
		font-size: var(--text-sm);
		color: var(--accent-regular);
		font-weight: 600;
		margin-bottom: 0.4rem;
	}

	.pub-title {
		font-size: var(--text-lg);
		color: var(--gray-0);
		font-weight: 600;
		margin: 0 0 0.3rem;
	}

	.pub-authors {
		font-size: var(--text-sm);
		color: var(--gray-400);
		margin-bottom: 0.5rem;
	}

	.pub-abstract {
		font-size: var(--text-sm);
		color: var(--gray-300);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin-bottom: 0.75rem;
	}

	.pub-links {
		display: flex;
		gap: 0.75rem;
	}

	.pub-link {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		font-size: var(--text-sm);
		color: var(--accent-regular);
		text-decoration: none;
		font-weight: 500;
	}
	.pub-link:hover { text-decoration: underline; }

	.cta-row {
		display: flex;
		justify-content: flex-end;
		margin-top: 0.5rem;
	}

	@media (min-width: 50em) {
		.now-card {
			flex-direction: row;
			align-items: flex-start;
			gap: 2rem;
			padding: 2rem;
			border-radius: 1.5rem;
		}

		.now-project-info {
			flex: 1;
		}

		.now-latest-update {
			flex: 0 0 14rem;
			padding-top: 0;
			padding-left: 2rem;
			border-top: none;
			border-left: 1px solid var(--gray-800);
		}

		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: 'header header header header' 'gallery gallery gallery gallery';
			gap: 5rem;
		}

		.section.with-cta {
			grid-template-areas: 'header header header cta' 'gallery gallery gallery gallery';
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h3 { font-size: var(--text-4xl); }

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery { grid-area: gallery; }
		.cta { grid-area: cta; }

		.pub-card { border-radius: 1.5rem; padding: 2rem; }
		.pub-title { font-size: var(--text-xl); }
	}
</style>
