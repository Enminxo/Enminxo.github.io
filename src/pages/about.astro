---
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/translations';

const lang = 'en';
const t = useTranslations(lang);
---

<BaseLayout title="About | Enmin Zhong" description={t('bio.title')} lang={lang}>
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero title={t('bio.title')} tagline="GTI-UPM · Madrid, Spain" align="start" />

			<section>
				<h2 class="section-title">Bio</h2>
				<div class="content">
					<p>{t('bio.p1')}</p>
					<p>{t('bio.p2')}</p>
				</div>
			</section>

			<section>
				<h2 class="section-title">{t('interests.label')}</h2>
				<div class="content">
					<ul>
						<li>{t('interests.1')}</li>
						<li>{t('interests.2')}</li>
						<li>{t('interests.3')}</li>
						<li>{t('interests.4')}</li>
					</ul>
				</div>
			</section>

			<section>
				<h2 class="section-title">Institution</h2>
				<div class="content">
					<p>
						<a href="https://www.gti.ssr.upm.es" target="_blank" rel="noopener noreferrer">
							Grupo de Tratamiento de Imágenes (GTI)
						</a>
						<br />
						Universidad Politécnica de Madrid
					</p>
				</div>
			</section>
		</main>

		<ContactCTA lang={lang} />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content { grid-column: 2 / 4; }

	.content p { line-height: 1.6; margin-bottom: 1rem; }

	.content ul {
		padding-left: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.content a {
		color: var(--accent-regular);
		text-decoration: none;
	}
	.content a:hover { text-decoration: underline; }

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) { grid-column-start: 2; }

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
