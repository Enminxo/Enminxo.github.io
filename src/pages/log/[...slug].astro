---
import { type CollectionEntry, getCollection, render } from 'astro:content';

import ContactCTA from '../../components/ContactCTA.astro';
import Icon from '../../components/Icon.astro';
import Pill from '../../components/Pill.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const logs = await getCollection('logs');
	return logs
		.filter((l) => l.data.lang === 'en')
		.map((entry) => ({
			params: { slug: entry.id },
			props: { entry },
		}));
}

interface Props {
	entry: CollectionEntry<'logs'>;
}

const lang = 'en';

const { entry } = Astro.props;
const { Content } = await render(entry);

const allWork = await getCollection('work');
const project = allWork.find((w) => w.id === entry.data.project);

const allLogs = await getCollection('logs');
const projectLogs = allLogs
	.filter((l) => l.data.project === entry.data.project && l.data.lang === 'en')
	.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const entryNumber = projectLogs.findIndex((l) => l.id === entry.id) + 1;

const dateFormatted = entry.data.date.toLocaleDateString('en-GB', {
	day: 'numeric',
	month: 'long',
	year: 'numeric',
});
---

<BaseLayout title={`${entry.data.title} | ${project?.data.title ?? 'Enmin Zhong'}`} description={entry.data.summary} lang={lang}>
	<div class="stack gap-20">
		<div class="stack gap-15">
			<header>
				<div class="wrapper entry-head stack gap-3">
					{project && (
						<a class="back-link" href={`/projects/${project.id}/`}>
							<Icon icon="arrow-left" /> {project.data.title}
						</a>
					)}
					<div class="entry-meta">
						<span class="entry-number">Entry #{entryNumber}</span>
						<time class="entry-date" datetime={entry.data.date.toISOString()}>{dateFormatted}</time>
					</div>
					<h1 class="entry-title">{entry.data.title}</h1>
					{entry.data.subtitle && <p class="entry-subtitle">{entry.data.subtitle}</p>}
					{entry.data.tags && (
						<div class="entry-tags">
							{entry.data.tags.map((tag) => <Pill>{tag}</Pill>)}
						</div>
					)}
				</div>
			</header>

			<main class="wrapper">
				<div class="article-layout">
					<div class="content">
						{entry.data.img && (
							<img src={entry.data.img} alt={entry.data.img_alt || ''} />
						)}
						<Content />
					</div>
					<aside class="toc" aria-label="Table of contents">
						<button class="toc-rail" id="toc-rail" type="button" aria-label="Contents"></button>
						<nav class="toc-panel">
							<p class="toc-title">Contents</p>
							<ul class="toc-list" id="toc-list"></ul>
						</nav>
					</aside>
				</div>

				<!-- Prev / Next navigation -->
				<nav class="log-nav">
					{entryNumber > 1 && (
						<a class="log-nav-link prev" href={`/log/${projectLogs[entryNumber - 2].id}/`}>
							<Icon icon="arrow-left" size="0.9em" />
							<span>
								<span class="nav-label">Previous</span>
								<span class="nav-title">{projectLogs[entryNumber - 2].data.title}</span>
							</span>
						</a>
					)}
					{entryNumber < projectLogs.length && (
						<a class="log-nav-link next" href={`/log/${projectLogs[entryNumber].id}/`}>
							<span>
								<span class="nav-label">Next</span>
								<span class="nav-title">{projectLogs[entryNumber].data.title}</span>
							</span>
							<Icon icon="arrow-right" size="0.9em" />
						</a>
					)}
				</nav>
			</main>
		</div>
		<ContactCTA />
	</div>
</BaseLayout>

<style>
	header {
		--measure: 44rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--gray-800);
	}

	.back-link {
		display: none;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--text-sm);
		color: var(--gray-400);
		text-decoration: none;
	}
	.back-link:hover { color: var(--gray-0); }

	.entry-meta {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 0.5rem;
	}

	.entry-number {
		font-size: var(--text-sm);
		font-weight: 700;
		color: var(--accent-regular);
		text-transform: uppercase;
		letter-spacing: 0.07em;
	}

	.entry-date {
		font-size: var(--text-sm);
		color: var(--gray-400);
	}

	/* The title spans the reading column, like the text below it */
	.entry-title {
		font-size: var(--text-2xl);
		color: var(--gray-0);
		font-weight: 700;
		line-height: 1.15;
	}

	.entry-subtitle {
		margin-top: 0.75rem;
		font-size: var(--text-lg);
		font-style: italic;
		color: var(--gray-300);
		line-height: 1.4;
	}

	.entry-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1.25rem;
	}
	/* Smaller tags here than on project pages, so they do not compete with the title */
	.entry-tags :global(.pill) {
		padding: 0.25rem 0.75rem;
		font-size: var(--text-sm);
	}

	/* One centred reading column: under 90 characters per line, so the eye does not
	   travel far to find the next one. The header lines up with it. */
	.entry-head {
		max-width: calc(var(--measure) + 3rem);
	}

	.content {
		--measure: 44rem;
		min-width: 0;
		overflow-x: hidden;
		overflow-wrap: break-word;
	}

	.content > :global(*) {
		max-width: var(--measure);
		margin-inline: auto;
	}

	/* Justified text, hyphenated so the spaces between words stay even */
	.content :global(p),
	.content :global(li) {
		text-align: justify;
		hyphens: auto;
	}

	/* Floating index — hidden on mobile */
	.toc {
		display: none;
	}

	.content > :global(* + *) { margin-top: 1rem; }

	.content :global(h2) {
		font-size: var(--text-xl);
		font-weight: 700;
		color: var(--gray-100);
		margin: 2rem 0 0.6rem;
	}

	.content :global(h3) {
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-100);
		margin: 1.75rem 0 0.5rem;
	}

	.content :global(h4) {
		font-size: var(--text-md);
		font-weight: 600;
		color: var(--gray-200);
		margin: 1.5rem 0 0.4rem;
	}

	.content :global(img) {
		border-radius: 1rem;
		box-shadow: var(--shadow-sm);
		border: 1px solid var(--gray-800);
	}

	/* Figures share the column with the text: centred, never wider than it nor taller
	   than most of the screen. */
	.content :global(img),
	.content :global(video) {
		display: block;
		margin-inline: auto;
		width: auto;
		height: auto;
		max-width: min(100%, var(--measure));
		max-height: 75vh;
		object-fit: contain;
	}

	.content :global(pre) {
		border-radius: 0.75rem;
		padding: 1.25rem;
		overflow-x: auto;
		font-size: var(--text-sm);
		background: var(--gray-900, #0d0d0d);
		border: 1px solid var(--gray-800);
	}

	.content :global(code:not(pre code)) {
		font-size: 0.875em;
		background: var(--gray-800);
		padding: 0.1em 0.4em;
		border-radius: 0.3em;
	}

	.content :global(ul),
	.content :global(ol) {
		padding-left: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.content :global(a) {
		color: var(--accent-regular);
		text-underline-offset: 0.2em;
	}

	.content :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--text-sm);
		margin: 1rem 0;
	}

	.content :global(th) {
		text-align: left;
		font-weight: 600;
		color: var(--gray-300);
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--gray-700);
	}

	.content :global(td) {
		padding: 0.5rem 0.75rem;
		color: var(--gray-200);
		border-bottom: 1px solid var(--gray-800);
		vertical-align: top;
	}

	.content :global(tr:last-child td) {
		border-bottom: none;
	}

	.content :global(blockquote) {
		border-left: 3px solid var(--accent-regular);
		padding: 0.75rem 1rem;
		margin: 1rem 0;
		background: var(--gray-900, #0d0d0d);
		border-radius: 0 0.5rem 0.5rem 0;
		color: var(--gray-200);
		font-size: var(--text-sm);
	}

	.content :global(blockquote strong) {
		color: var(--accent-regular);
	}

	.content :global(hr) {
		border: none;
		border-top: 1px solid var(--gray-800);
		margin: 2rem 0;
	}

	/* Headings, rules and blocks set their own margins above: keep them in the column too */
	.content > :global(:is(h2, h3, h4, h5, h6, hr, blockquote, pre, ul, ol, table)) {
		margin-inline: auto;
	}

	/* Prev/Next nav */
	.log-nav {
		max-width: 44rem;
		margin-inline: auto;
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--gray-800);
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.log-nav-link {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--gray-300);
		max-width: 22ch;
	}
	.log-nav-link:hover { color: var(--gray-0); }

	.log-nav-link span {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.log-nav-link.next {
		margin-left: auto;
		text-align: right;
	}
	.log-nav-link.next span { align-items: flex-end; }

	.nav-label {
		font-size: var(--text-xs, 0.75rem);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--gray-400);
		font-weight: 600;
	}

	.nav-title {
		font-size: var(--text-sm);
		font-weight: 500;
	}

	@media (min-width: 50em) {
		.back-link { display: flex; }
		.entry-title { font-size: var(--text-3xl); }
	}

	@media (min-width: 50em) {
		/* A rail of marks at the right edge, one per section. Hovering it (or focusing it,
		   for keyboard and touch) opens the panel with the section titles. */
		.toc {
			display: block;
			position: fixed;
			top: 50%;
			right: 0.5rem;
			transform: translateY(-50%);
			z-index: 20;
		}

		.toc-rail {
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			gap: 0.55rem;
			padding: 0.75rem 0.4rem;
			border: none;
			background: none;
			cursor: pointer;
		}

		.toc-rail :global(.toc-mark) {
			display: block;
			width: 1rem;
			height: 2px;
			border-radius: 2px;
			background: var(--gray-600);
			transition: background 0.15s, width 0.15s;
		}

		.toc-rail :global(.toc-mark--sub) { width: 0.6rem; }

		.toc-rail :global(.toc-mark.active) {
			background: var(--accent-regular);
			width: 1.4rem;
		}

		.toc-panel {
			position: absolute;
			top: 50%;
			right: 0;
			width: 17rem;
			max-height: 75vh;
			overflow-y: auto;
			padding: 1rem 1rem 1rem 0.75rem;
			border: 1px solid var(--gray-800);
			border-radius: 0.9rem;
			background: var(--gray-999);
			box-shadow: var(--shadow-md);
			opacity: 0;
			visibility: hidden;
			transform: translate(0.75rem, -50%);
			transition: opacity 0.18s, transform 0.18s, visibility 0.18s;
		}

		.toc:hover .toc-panel,
		.toc:focus-within .toc-panel {
			opacity: 1;
			visibility: visible;
			transform: translate(0, -50%);
		}

		.toc-title {
			font-size: var(--text-sm);
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--gray-400);
			margin-bottom: 0.75rem;
			padding-left: 0.75rem;
		}

		.toc :global(.toc-list) {
			list-style: none;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
		}

		.toc :global(.toc-item a) {
			font-size: var(--text-sm);
			color: var(--gray-400);
			text-decoration: none;
			line-height: 1.4;
			display: block;
			padding: 0.15rem 0;
			border-left: 2px solid transparent;
			padding-left: 0.75rem;
			transition: color 0.15s, border-color 0.15s;
		}

		.toc :global(.toc-item a:hover),
		.toc :global(.toc-item a.active) {
			color: var(--gray-0);
			border-left-color: var(--accent-regular);
		}

		.toc :global(.toc-item--sub a) {
			padding-left: 1.5rem;
			font-size: 0.8rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.toc-panel { transition: none; }
	}
</style>

<script>
	const tocList = document.getElementById('toc-list');
	const tocRail = document.getElementById('toc-rail');
	if (tocList) {
		const headings = document.querySelectorAll<HTMLElement>('.content h2, .content h3');
		headings.forEach((heading) => {
			if (!heading.id) {
				heading.id = heading.textContent!.trim().toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
			}
			const li = document.createElement('li');
			li.className = heading.tagName === 'H3' ? 'toc-item toc-item--sub' : 'toc-item';
			const a = document.createElement('a');
			a.href = `#${heading.id}`;
			a.textContent = heading.textContent;
			li.appendChild(a);
			tocList.appendChild(li);

			const mark = document.createElement('span');
			mark.className = heading.tagName === 'H3' ? 'toc-mark toc-mark--sub' : 'toc-mark';
			mark.dataset.target = heading.id;
			tocRail?.appendChild(mark);
		});

		// Highlight the section being read: the last heading that has passed the top third of the screen
		const marks = tocRail ? Array.from(tocRail.querySelectorAll<HTMLElement>('.toc-mark')) : [];
		const links = Array.from(tocList.querySelectorAll<HTMLAnchorElement>('a'));
		const highlightCurrent = () => {
			const line = window.innerHeight / 3;
			let current = -1;
			headings.forEach((heading, i) => {
				if (heading.getBoundingClientRect().top <= line) current = i;
			});
			links.forEach((link, i) => link.classList.toggle('active', i === current));
			marks.forEach((mark, i) => mark.classList.toggle('active', i === current));
		};
		window.addEventListener('scroll', highlightCurrent, { passive: true });
		window.addEventListener('resize', highlightCurrent);
		highlightCurrent();
	}
</script>
