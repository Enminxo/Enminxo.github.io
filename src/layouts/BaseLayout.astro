---
// Learn about using Astro layouts:
// https://docs.astro.build/en/basics/layouts/

import Footer from '../components/Footer.astro';
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import type { Lang } from '../i18n/translations';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	lang?: Lang;
}

const { title, description, lang = 'en' } = Astro.props;
---

<html lang={lang}>
	<head>
		<MainHead title={title} description={description} />
		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-V00HGSNEXL"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() { dataLayer.push(arguments); }
			gtag('js', new Date());
			gtag('config', 'G-V00HGSNEXL');
		</script>
	</head>
	<body>
		<div class="stack backgrounds">
			<Nav lang={lang} />
			<slot />
			<Footer />
		</div>

		<script>
			// Add “loaded” class once the document has completely loaded.
			addEventListener('load', () => document.documentElement.classList.add('loaded'));
		</script>

		<style>
			/* A plain page background: white in the light theme, near-black in the dark one
			   (--gray-999 in global.css), without the template's purple gradient images. */
			.backgrounds {
				min-height: 100%;
				isolation: isolate;
				background: var(--gray-999);
			}
		</style>
	</body>
</html>
