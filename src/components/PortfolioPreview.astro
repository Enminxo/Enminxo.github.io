---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;

const statusColors: Record<string, string> = {
	'completed': 'var(--accent-regular)',
	'in progress': '#f59e0b',
	'prototyping': '#8b5cf6',
	'idea': 'var(--gray-600)',
};

const statusColor = data.status ? (statusColors[data.status] ?? 'var(--gray-600)') : undefined;
---

<a class="card" href={`/projects/${id}`}>
	<div class="card-bg" aria-hidden="true">
		{data.img
			? <img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
			: <div class="card-gradient" />
		}
	</div>
	<div class="card-body">
		<span class="title">{data.title}</span>
		<p class="desc">{data.description}</p>
		<div class="meta">
			<div class="tags">
				{data.tags.slice(0, 3).map((tag) => (
					<span class="tag">{tag}</span>
				))}
			</div>
			{data.status && (
				<span class="status" style={`background: ${statusColor}22; color: ${statusColor}; border: 1px solid ${statusColor}55;`}>
					{data.status}
				</span>
			)}
		</div>
	</div>
</a>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 14rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition: box-shadow var(--theme-transition), border-color var(--theme-transition);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
		border-color: var(--gray-600);
	}

	.card-bg {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.card-bg img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.3;
	}

	.card-gradient {
		width: 100%;
		height: 100%;
		background: var(--gradient-subtle);
	}

	.card-body {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		height: 100%;
		padding: 1.25rem;
	}

	.title {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--gray-0);
		line-height: 1.2;
	}

	.desc {
		font-size: var(--text-sm);
		color: var(--gray-300);
		line-height: 1.4;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		margin-top: 0.4rem;
	}

	.meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-top: 0.75rem;
	}

	.tags {
		display: flex;
		gap: 0.375rem;
		flex-wrap: wrap;
	}

	.tag {
		font-size: 0.7rem;
		padding: 0.15rem 0.5rem;
		border-radius: 999rem;
		background: var(--gray-800);
		color: var(--gray-300);
	}

	.status {
		font-size: 0.65rem;
		padding: 0.15rem 0.5rem;
		border-radius: 999rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	@media (min-width: 50em) {
		.card {
			height: 20rem;
			border-radius: 1.5rem;
		}

		.card-body { padding: 1.75rem; }
		.title { font-size: var(--text-xl); }
		.desc { -webkit-line-clamp: 3; }
	}
</style>
